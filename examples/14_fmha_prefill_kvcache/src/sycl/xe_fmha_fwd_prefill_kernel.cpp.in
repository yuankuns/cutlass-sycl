#endif

#if @HEAD_DIM@ == 64
  AT_DISPATCH_BOOL_NO_RETURN(use_sink, Sink, {
    AT_DISPATCH_BOOL_NO_RETURN(params.is_local, LocalMask, {
      AT_DISPATCH_BOOL_NO_RETURN(params.is_causal, Causal, {
