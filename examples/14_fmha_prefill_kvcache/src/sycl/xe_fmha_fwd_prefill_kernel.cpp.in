#if @EMIT_PAGED@
  // The third mode is GEMM1's head-dim reduction step: one Q and one K load per step,
  // so widening it moves the same bytes in fewer load instructions (see QK_KSTEP).
  using TileShapeQK = cute::Shape<cute::Int<@TILED_Q@>, cute::Int<@TILED_KV@>, cute::Int<@QK_KSTEP@>>;
  using TileShapePV = cute::Shape<cute::Int<@TILED_Q@>, cute::_32, cute::Int<@TILED_KV@>>;
  // Round the head-dim of the output tile up to a multiple of get<1>(TileShapePV) (32) so that
  // VTiles = get<1>(TileShapeOutput) / get<1>(TileShapePV) covers the full head dimension when
  // HEAD_DIM is not a multiple of 32 (e.g. HEAD_DIM=72 -> 96, VTiles=3). The actual O surface is
